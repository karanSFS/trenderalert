# TrenderAlert frontend runs entirely on local mock data. No backend URL is configured yet.

# Artificial latency (ms) applied by the mock service layer so loading skeletons are visible.
NEXT_PUBLIC_MOCK_DELAY_MS=450

# Probability (0-1) that any mock request fails. Use for testing error states.
NEXT_PUBLIC_MOCK_FAILURE_RATE=0

# Comma-separated mock service keys that always fail (e.g. "auth,dashboard").
NEXT_PUBLIC_MOCK_FAIL_SERVICES=
